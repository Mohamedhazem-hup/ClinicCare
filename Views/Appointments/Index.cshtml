@model List<Appointment>
@{
    ViewData["Title"] = "Appointments";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Appointments</h2>
        <p class="page-subtitle">@Model.Count total appointments</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Book Appointment</a>
    }
</div>

<div class="table-container">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr><th>Date &amp; Time</th><th>Patient</th><th>Doctor</th><th>Status</th><th>Reason</th><th></th></tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-secondary py-4">No appointments found.</td></tr>
                }
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.AppointmentDate.ToString("dd MMM yyyy, HH:mm")</td>
                        <td>@a.Patient?.FullName</td>
                        <td>@a.Doctor?.FullName</td>
                        <td><span class="badge">@a.Status</span></td>
                        <td>@(a.Reason ?? "-")</td>
                        <td class="text-end">
                            @if (User.IsInRole("Receptionist") && a.Status == "Scheduled")
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@a.AppointmentId" />
                                    <input type="hidden" name="status" value="Waiting" />
                                    <button type="submit" class="btn btn-primary btn-sm">Check in</button>
                                </form>
                            }
                            @if (User.IsInRole("Doctor") && (a.Status == "Waiting" || a.Status == "Checked-In"))
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@a.AppointmentId" />
                                    <input type="hidden" name="status" value="@(a.Status == "Waiting" ? "Checked-In" : "Completed")" />
                                    <button type="submit" class="btn btn-primary btn-sm">@(a.Status == "Waiting" ? "Start visit" : "Complete")</button>
                                </form>
                            }
                            <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-info btn-sm">View</a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                            {
                                <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-secondary btn-sm">Edit</a>
                                <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this appointment?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
