@model Bill
@{
    ViewData["Title"] = "Bill Details";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Bill #@Model.Id</h2>
        <p class="page-subtitle">@Model.IssueDate.ToString("dd MMM yyyy")</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back</a>
</div>

<div class="profile-card">
    <div class="row g-3">
        <div class="col-md-4"><strong>Patient:</strong> @Model.Patient?.FullName</div>
        <div class="col-md-4"><strong>Total:</strong> @Model.Amount.ToString("N2") EGP</div>
        <div class="col-md-4"><strong>Paid:</strong> @Model.Payments.Sum(payment => payment.Amount).ToString("N2") EGP</div>
        <div class="col-md-4"><strong>Balance:</strong> @Math.Max(0, Model.Amount - Model.Payments.Sum(payment => payment.Amount)).ToString("N2") EGP</div>
        <div class="col-md-4"><strong>Status:</strong> <span class="badge">@Model.Status</span></div>
        <div class="col-md-4"><strong>Issue Date:</strong> @Model.IssueDate.ToString("dd MMM yyyy")</div>
        <div class="col-md-4"><strong>Due Date:</strong> @(Model.DueDate?.ToString("dd MMM yyyy") ?? "-")</div>
        <div class="col-md-4"><strong>Paid Date:</strong> @(Model.PaidDate?.ToString("dd MMM yyyy") ?? "-")</div>
        <div class="col-12"><strong>Description:</strong> @(Model.Description ?? "-")</div>
    </div>

    <h3 class="mt-4">Bill items</h3>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Description</th><th>Quantity</th><th>Unit price</th><th>Line total</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr><td>@item.Description</td><td>@item.Quantity</td><td>@item.UnitPrice.ToString("N2") EGP</td><td>@item.LineTotal.ToString("N2") EGP</td></tr>
                }
            </tbody>
        </table>
    </div>

    <h3 class="mt-4">Payments</h3>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Date</th><th>Method</th><th>Recorded by</th><th>Amount</th></tr></thead>
            <tbody>
                @if (!Model.Payments.Any())
                {
                    <tr><td colspan="4" class="text-center text-secondary py-3">No payments recorded.</td></tr>
                }
                @foreach (var payment in Model.Payments.OrderByDescending(payment => payment.PaymentDate))
                {
                    <tr><td>@payment.PaymentDate.ToString("dd MMM yyyy HH:mm")</td><td>@payment.Method</td><td>@(payment.RecordedBy?.FullName ?? "-")</td><td>@payment.Amount.ToString("N2") EGP</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
    {
        <div class="mt-3">
            @if (Model.PaymentStatus != "Paid" && Model.PaymentStatus != "Cancelled")
            {
                <form asp-action="RecordPayment" asp-route-id="@Model.BillId" method="post" class="row g-2 align-items-end mb-3">
                    <div class="col-md-3"><label class="form-label">Payment amount</label><input type="number" name="amount" min="0.01" max="@Math.Max(0, Model.Amount - Model.Payments.Sum(payment => payment.Amount))" step="0.01" class="form-control" required /></div>
                    <div class="col-md-3"><label class="form-label">Method</label><select name="method" class="form-select"><option>Cash</option><option>Card</option><option>Bank Transfer</option><option>Insurance</option></select></div>
                    <div class="col-md-3"><button type="submit" class="btn btn-success">Record payment</button></div>
                </form>
                <form asp-action="MarkPaid" asp-route-id="@Model.BillId" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-success">Pay remaining balance</button>
                </form>
            }
            <a asp-action="Edit" asp-route-id="@Model.BillId" class="btn btn-secondary">Edit</a>
        </div>
    }
</div>
