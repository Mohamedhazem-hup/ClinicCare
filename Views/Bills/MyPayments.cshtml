@model List<Payment>
@{
    ViewData["Title"] = "My Payments";
    var totalPaid = Model.Sum(payment => payment.Amount);
}

<div class="page-header">
    <div>
        <h2 class="page-title">My Payments</h2>
        <p class="page-subtitle">Total recorded: @totalPaid.ToString("N2") EGP</p>
    </div>
</div>

<div class="table-container">
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Date</th><th>Bill</th><th>Method</th><th>Amount</th></tr></thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="text-center text-secondary py-4">No payments recorded yet.</td></tr>
            }
            @foreach (var payment in Model)
            {
                <tr>
                    <td>@payment.PaymentDate.ToString("dd MMM yyyy HH:mm")</td>
                    <td><a asp-controller="Bills" asp-action="Details" asp-route-id="@payment.BillId">Bill #@payment.BillId</a></td>
                    <td>@payment.Method</td>
                    <td>@payment.Amount.ToString("N2") EGP</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
