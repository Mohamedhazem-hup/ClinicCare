@model MedicalRecord
@{
    ViewData["Title"] = "Medical Record";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Medical Record</h2>
        <p class="page-subtitle">@Model.VisitDate.ToString("dd MMM yyyy")</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back</a>
</div>

<div class="profile-card mb-3">
    <div class="row g-3">
        <div class="col-md-4"><strong>Patient:</strong> @Model.Patient?.FullName</div>
        <div class="col-md-4"><strong>Doctor:</strong> @Model.Doctor?.FullName</div>
        <div class="col-md-4"><strong>Visit Date:</strong> @Model.VisitDate.ToString("dd MMM yyyy")</div>
        <div class="col-12"><strong>Diagnosis:</strong> @Model.Diagnosis</div>
        <div class="col-12"><strong>Chief Complaint:</strong> @(Model.ChiefComplaint ?? "-")</div>
        <div class="col-12"><strong>Symptoms:</strong> @(Model.Symptoms ?? "-")</div>
        <div class="col-md-4"><strong>Blood Pressure:</strong> @(Model.BloodPressure ?? "-")</div>
        <div class="col-md-4"><strong>Temperature:</strong> @(Model.Temperature?.ToString("0.0") ?? "-") °C</div>
        <div class="col-md-4"><strong>Weight:</strong> @(Model.Weight?.ToString("0.0") ?? "-") kg</div>
        <div class="col-12"><strong>Treatment:</strong> @(Model.Treatment ?? "-")</div>
        <div class="col-12"><strong>Notes:</strong> @(Model.Notes ?? "-")</div>
    </div>
</div>

<div class="content-card">
    <div class="card-header-modern"><h3>Prescriptions from this visit</h3></div>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Date</th><th>Medicines</th></tr></thead>
            <tbody>
                @if (!Model.Prescriptions.Any())
                {
                    <tr><td colspan="2" class="text-center text-secondary py-3">No prescriptions linked.</td></tr>
                }
                @foreach (var p in Model.Prescriptions)
                {
                    <tr>
                        <td>@p.DateIssued.ToString("dd MMM yyyy")</td>
                        <td><ul class="mb-0 ps-3">@foreach (var item in p.Items) { <li>@item.MedicineName, @item.Dosage, @item.Frequency for @item.Duration</li> }</ul></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
