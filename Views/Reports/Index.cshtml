@model ClinicManagementSystem.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "Reports";
}

<h1 class="mb-4">Reports</h1>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="dashboard-card"><h5>Today's revenue</h5><h2>@Model.RevenueToday.ToString("N2") EGP</h2></div></div>
    <div class="col-md-4"><div class="dashboard-card"><h5>Overdue balance</h5><h2>@Model.OverdueBalance.ToString("N2") EGP</h2></div></div>
    <div class="col-md-4"><div class="dashboard-card"><h5>New patients today</h5><h2>@Model.NewPatientsToday</h2></div></div>
</div>

<h3>Appointments by Doctor</h3>
@if (!Model.AppointmentsByDoctor.Any())
{
    <p class="text-muted">No appointment data yet.</p>
}
else
{
    <div class="table-responsive mb-5">
        <table class="table table-hover">
            <thead><tr><th>Doctor</th><th>Total Appointments</th><th>Completed</th><th>Cancelled</th></tr></thead>
            <tbody>
            @foreach (var item in Model.AppointmentsByDoctor)
            {
                <tr><td>@item.DoctorName</td><td>@item.TotalAppointments</td><td>@item.Completed</td><td>@item.Cancelled</td></tr>
            }
            </tbody>
        </table>
    </div>
}

<h3>Revenue by Month (Payments received)</h3>
@if (!Model.RevenueByMonth.Any())
{
    <p class="text-muted">No paid bills yet.</p>
}

<h3 class="mt-5">Overdue Bills</h3>
@if (!Model.OverdueBills.Any())
{
    <p class="text-muted">No overdue bills.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Bill</th><th>Patient</th><th>Due date</th><th>Balance</th></tr></thead>
            <tbody>
            @foreach (var bill in Model.OverdueBills)
            {
                <tr><td><a asp-controller="Bills" asp-action="Details" asp-route-id="@bill.BillId">#@bill.BillId</a></td><td>@bill.PatientName</td><td>@bill.DueDate.ToString("dd MMM yyyy")</td><td>@bill.Balance.ToString("N2") EGP</td></tr>
            }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Month</th><th>Total Revenue</th></tr></thead>
            <tbody>
            @foreach (var item in Model.RevenueByMonth)
            {
                <tr><td>@item.MonthLabel</td><td>@item.TotalRevenue EGP</td></tr>
            }
            </tbody>
        </table>
    </div>
}
