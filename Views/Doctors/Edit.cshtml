@model Doctor
@{
    ViewData["Title"] = "Edit Doctor";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Edit Doctor</h2>
        <p class="page-subtitle">@Model.FullName</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back</a>
</div>

<div class="form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label asp-for="Specialization" class="form-label"></label>
                <input asp-for="Specialization" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary mt-4"><i class="fa-solid fa-check"></i> Save Changes</button>
    </form>
</div>
