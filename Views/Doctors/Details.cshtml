@model Doctor
@{
    ViewData["Title"] = "Doctor Details";
}

<div class="page-header">
    <div>
        <h2 class="page-title">@Model.FullName</h2>
        <p class="page-subtitle">@Model.Specialization</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back</a>
</div>

<div class="profile-card mb-3">
    <div class="d-flex align-items-center gap-3">
        <div class="profile-avatar">@Model.FullName.Substring(0,1)</div>
        <div>
            <div class="profile-name-large">@Model.FullName</div>
            <div class="profile-meta">@Model.Specialization · @(Model.Phone ?? "No phone")</div>
        </div>
    </div>
</div>

<div class="content-card">
    <div class="card-header-modern"><h3>Appointments</h3></div>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Date</th><th>Patient</th><th>Status</th></tr></thead>
            <tbody>
                @if (!Model.Appointments.Any())
                {
                    <tr><td colspan="3" class="text-center text-secondary py-3">No appointments yet.</td></tr>
                }
                @foreach (var a in Model.Appointments.OrderByDescending(a => a.AppointmentDate))
                {
                    <tr>
                        <td>@a.AppointmentDate.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@a.Patient?.FullName</td>
                        <td><span class="badge">@a.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
